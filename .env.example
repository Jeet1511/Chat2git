# Optional GitHub token. Use a fine-grained PAT with access only to selected repositories.
# Public repository reading works without a token.
GITHUB_TOKEN=

# Local dashboard/API bind address. Only 127.0.0.1 or localhost are accepted.
HOST=127.0.0.1
PORT=4317

# Key required on every /api/* request (X-Chat2git-Key). If empty, a random key is generated
# at startup and printed to the console. Generate a fixed one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_API_KEY=

# Writes (branches, files, deletes, pull requests) are OFF by default.
# Set to true only if you want agents to be able to change repositories.
CHAT2GIT_ALLOW_WRITES=false

# Optional maximum bytes returned for one source file (default 1 MiB).
MAX_FILE_BYTES=1048576
